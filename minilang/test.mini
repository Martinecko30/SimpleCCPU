func print(str_ptr) {
    let cursor = 97
    let i = 0
    let char = str_ptr[i]

    while (char != 0) {
        *cursor = char

        cursor = cursor + 1

        i = i + 1
        char = str_ptr[i]
    }
}

func test(arg1, arg2, arg3, arg4, arg5) {
    return arg1 * arg2 / arg3 + arg4 - arg5
}

